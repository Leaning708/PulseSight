# 默认按文本处理,统一 LF
* text=auto eol=lf

# Dart 与配置文件
*.dart text
*.yaml text
*.yml text
*.json text
*.md text
*.sh text
*.gradle text

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.jar binary
*.jks binary
*.keystore binary

# 生成文件在统计/diff 中折叠
*.g.dart linguist-generated=true
*.pbxproj linguist-generated=true
*.gradle linguist-generated=false
